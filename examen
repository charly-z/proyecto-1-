<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Examen de Verbos</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f2f6fc;
      padding: 30px;
      max-width: 800px;
      margin: auto;
      display: none;
    }

    h1, h2 {
      text-align: center;
      color: #2c3e50;
    }

    p {
      font-size: 18px;
      margin-bottom: 10px;
    }

    button {
      background-color: #3498db;
      color: white;
      border: none;
      padding: 10px 20px;
      margin: 5px;
      border-radius: 5px;
      cursor: pointer;
      font-size: 16px;
    }

    button:hover {
      background-color: #2980b9;
    }

    #startScreen, #quiz, #puntajeFinal {
      display: none;
    }

    .visible {
      display: block;
    }

    p[id^="resultado"] {
      font-weight: bold;
      margin-bottom: 30px;
    }
  </style>
</head>
<body>
  <div id="startScreen" class="visible">
    <h1>Examen de Verbos en Inglés</h1>
    <p>Responde las 30 preguntas. ¡Cada acierto te motiva a seguir!</p>
    <div style="text-align:center;">
      <button onclick="iniciarExamen()">Comenzar Examen</button>
    </div>
  </div>

  <div id="quiz"></div>

  <div id="finalScreen">
    <h2 id="puntajeFinal"></h2>
    <div style="text-align:center;">
      <button onclick="reiniciarExamen()">Reiniciar Examen</button>
    </div>
  </div>

<script>
 let score = 0;
    let totalPreguntas = 30;
    let respuestasContestadas = 0;

    const frasesMotivadoras = [
      "¡Correcto! Cada vez estás más cerca de conseguir lo que quieres.",
      "¡Bien hecho! Sigue esforzándote así y vas a lograr todo en la vida.",
      "¡Excelente! Estás un paso más cerca de ser millonario.",
      "¡Muy bien! Tu esfuerzo vale la pena.",
      "¡Increíble! Tu constancia te está llevando lejos.",
      "¡Eso es! Hoy estudias, mañana triunfas.",
      "¡Perfecto! Sigue así, estás brillando.",
      "¡Gran trabajo! Cada respuesta te hace más fuerte.",
      "¡Súper! Tu mente se está entrenando como un campeón.",
      "¡Lo lograste! Un día vas a dominar el inglés.",
      "¡Muy bien! Vas mejorando como un profesional.",
      "¡Excelente! Estás construyendo tu éxito.",
      "¡Genial! Cada palabra aprendida es poder.",
      "¡Fabuloso! Tu inteligencia es tu mejor herramienta.",
      "¡Wow! Tu disciplina está rindiendo frutos.",
      "¡Increíble trabajo! Te estás volviendo imparable.",
      "¡Espectacular! ¡Eres más capaz de lo que crees!",
      "¡Fantástico! Así se hace.",
      "¡Eso es tener actitud ganadora!",
      "¡Brillante! Eres una máquina de aprender.",
      "¡Correcto! Vas directo al éxito.",
      "¡Bien hecho! Estás desbloqueando tu potencial.",
      "¡Maravilloso! El aprendizaje es tu superpoder.",
      "¡Bravo! Estás más cerca de dominarlo todo.",
      "¡Sí! Cada paso cuenta, y tú no te detienes.",
      "¡Eres grande! Y cada acierto lo demuestra.",
      "¡Imparable! No hay quien te pare.",
      "¡Firme! Cada respuesta correcta es progreso.",
      "¡Motivador! Tu energía es contagiosa.",
      "¡Inspirador! Así se lucha por un objetivo."
    ];

    const preguntas = [
      { pregunta: "¿Cómo se dice 'correr' en inglés?", correcta: "Run", opciones: ["Rin", "Rak", "Run"] },
      { pregunta: "¿Cómo se dice 'saltar' en inglés?", correcta: "Jump", opciones: ["Slip", "Jump", "Shake"] },
      { pregunta: "¿Cómo se dice 'comer' en inglés?", correcta: "Eat", opciones: ["Come", "Eat", "Hit"] },
      { pregunta: "¿Cómo se dice 'dormir' en inglés?", correcta: "Sleep", opciones: ["Rest", "Sleep", "Sit"] },
      { pregunta: "¿Cómo se dice 'leer' en inglés?", correcta: "Read", opciones: ["Ride", "Read", "Red"] },
      { pregunta: "¿Cómo se dice 'escribir' en inglés?", correcta: "Write", opciones: ["Erase", "Draw", "Write"] },
      { pregunta: "¿Cómo se dice 'hablar' en inglés?", correcta: "Speak", opciones: ["Talk", "Speak", "Say"] },
      { pregunta: "¿Cómo se dice 'escuchar' en inglés?", correcta: "Listen", opciones: ["Hear", "Listen", "Look"] },
      { pregunta: "¿Cómo se dice 'beber' en inglés?", correcta: "Drink", opciones: ["Eat", "Drink", "Swallow"] },
      { pregunta: "¿Cómo se dice 'caminar' en inglés?", correcta: "Walk", opciones: ["Run", "Walk", "Stand"] },
      { pregunta: "¿Cómo se dice 'nadar' en inglés?", correcta: "Swim", opciones: ["Sink", "Swim", "Drown"] },
      { pregunta: "¿Cómo se dice 'volar' en inglés?", correcta: "Fly", opciones: ["Fly", "Float", "Throw"] },
      { pregunta: "¿Cómo se dice 'abrir' en inglés?", correcta: "Open", opciones: ["Open", "Break", "Push"] },
      { pregunta: "¿Cómo se dice 'cerrar' en inglés?", correcta: "Close", opciones: ["Shut", "Close", "Hide"] },
      { pregunta: "¿Cómo se dice 'jugar' en inglés?", correcta: "Play", opciones: ["Play", "Push", "Punch"] },
      { pregunta: "¿Cómo se dice 'cocinar' en inglés?", correcta: "Cook", opciones: ["Cook", "Burn", "Cut"] },
      { pregunta: "¿Cómo se dice 'estudiar' en inglés?", correcta: "Study", opciones: ["Study", "Read", "Write"] },
      { pregunta: "¿Cómo se dice 'enseñar' en inglés?", correcta: "Teach", opciones: ["Teach", "Talk", "Tell"] },
      { pregunta: "¿Cómo se dice 'mirar' en inglés?", correcta: "Watch", opciones: ["See", "Look", "Watch"] },
      { pregunta: "¿Cómo se dice 'pensar' en inglés?", correcta: "Think", opciones: ["Know", "Guess", "Think"] },
      { pregunta: "¿Cómo se dice 'luchar' en inglés?", correcta: "Fight", opciones: ["Fight", "Fly", "Fold"] },
      { pregunta: "¿Cómo se dice 'empezar' en inglés?", correcta: "Begin", opciones: ["Bring", "Begin", "Break"] },
      { pregunta: "¿Cómo se dice 'construir' en inglés?", correcta: "Build", opciones: ["Buy", "Build", "Bend"] },
      { pregunta: "¿Cómo se dice 'romper' en inglés?", correcta: "Break", opciones: ["Bark", "Break", "Burn"] },
      { pregunta: "¿Cómo se dice 'comprar' en inglés?", correcta: "Buy", opciones: ["Bring", "Buy", "Burn"] },
      { pregunta: "¿Cómo se dice 'elegir' en inglés?", correcta: "Choose", opciones: ["Catch", "Choose", "Charge"] },
      { pregunta: "¿Cómo se dice 'venir' en inglés?", correcta: "Come", opciones: ["Cut", "Come", "Climb"] },
      { pregunta: "¿Cómo se dice 'dibujar' en inglés?", correcta: "Draw", opciones: ["Drop", "Drink", "Draw"] },
      { pregunta: "¿Cómo se dice 'manejar' en inglés?", correcta: "Drive", opciones: ["Dive", "Drive", "Drag"] },
      { pregunta: "¿Cómo se dice 'caer' en inglés?", correcta: "Fall", opciones: ["Feel", "Fall", "Fill"] }
    ];

    function iniciarExamen() {
      document.body.style.display = "block";
      document.getElementById("startScreen").style.display = "none";
      document.getElementById("quiz").style.display = "block";
      generarPreguntas();
    }

    function generarPreguntas() {
      const quizDiv = document.getElementById("quiz");
      preguntas.forEach((item, index) => {
        const contenedor = document.createElement("div");

        const pregunta = document.createElement("p");
        pregunta.innerHTML = `<strong>${index + 1}. ${item.pregunta}</strong>`;
        contenedor.appendChild(pregunta);

        item.opciones.forEach(opcion => {
          const boton = document.createElement("button");
          boton.textContent = opcion;
          boton.onclick = function () {
            const resultado = document.getElementById("resultado" + index);
            if (!resultado.textContent) {
              if (opcion === item.correcta) {
                resultado.textContent = frasesMotivadoras[index] || "¡Correcto!";
                resultado.style.color = "green";
                score++;
              } else {
                resultado.textContent = "Incorrecto. La respuesta correcta es: " + item.correcta + ".";
                resultado.style.color = "red";
              }
              actualizarPuntaje();
            }
          };
          contenedor.appendChild(boton);
        });

        const resultado = document.createElement("p");
        resultado.id = "resultado" + index;
        contenedor.appendChild(resultado);
        quizDiv.appendChild(contenedor);
      });
    }

    function actualizarPuntaje() {
      respuestasContestadas++;
      if (respuestasContestadas === totalPreguntas) {
        document.getElementById("quiz").style.display = "none";
        document.getElementById("finalScreen").style.display = "block";
        document.getElementById("puntajeFinal").textContent =
          "¡Examen completado! Obtuviste " + score + " de " + totalPreguntas + " respuestas correctas.";
      }
    }

    function reiniciarExamen() {
      location.reload();
    }
</script>
</body>
</html>
